---
interface InquiryFormProps {
  title?: string;
  subtitle?: string;
  showProductSelect?: boolean;
  products?: Array<{
    id: string;
    name: string;
  }>;
  locale?: string;
}

const { 
  title,
  subtitle,
  showProductSelect = false,
  products = [],
  locale = 'en'
} = Astro.props;

const translations: Record<string, Record<string, string>> = {
  en: {
    title: 'Send an Inquiry',
    subtitle: 'Fill out the form below and we will get back to you within 24 hours.',
    name: 'Your Name',
    email: 'Email Address',
    company: 'Company Name',
    phone: 'Phone Number',
    product: 'Product of Interest',
    selectProduct: 'Select a product',
    message: 'Your Message',
    messagePlaceholder: 'Please describe your requirements, quantities needed, delivery location, etc.',
    submit: 'Submit Inquiry',
    successTitle: 'Inquiry Submitted Successfully!',
    successMessage: 'Thank you for your message. Our team will respond within 24 hours.',
    errorTitle: 'Something went wrong!',
    errorMessage: 'Please try again later or contact us directly.'
  },
  de: {
    title: 'Anfrage senden',
