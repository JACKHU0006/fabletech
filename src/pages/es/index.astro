---
import MainLayout from '../../layouts/MainLayout.astro';
import InquiryForm from '../../components/InquiryForm.astro';
import { ArrowRight, TrendingUp, Award, Globe, Shield, Zap } from '@lucide/astro';
import { products } from '../../data/products';
import { news } from '../../data/news';

const locale = 'es';
const localizedProducts = products.slice(0, 4);
const localizedNews = news.slice(0, 3);
---

<MainLayout 
  title="FableTech Group - Fabricante de productos metálicos industriales" 
  description="Fabricante líder de productos metálicos industriales. Soluciones de alta calidad en acero, aluminio, cobre y titanio para mercados globales."
  locale={locale}
>
  <section class="bg-gradient-to-r from-primary to-primary-dark text-white py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row items-center justify-between">
        <div class="flex-1 text-center lg:text-left mb-8 lg:mb-0">
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6">
            Premium Industrial<br />
            <span class="text-secondary">Metal Products</span>
          </h1>
          <p class="text-lg text-gray-200 mb-8 max-w-xl mx-auto lg:mx-0">
            Leading manufacturer of steel, aluminum, copper, and titanium products. 
            Serving global markets with quality, reliability, and innovation.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
            <a href="/products" class="inline-flex items-center justify-center px-8 py-4 bg-secondary hover:bg-secondary/90 text-white font-semibold rounded-lg transition-colors">
              Ver productos
              <ArrowRight class="ml-2 h-5 w-5" />
            </a>
            <a href="/contact" class="inline-flex items-center justify-center px-8 py-4 border-2 border-white text-white font-semibold rounded-lg hover:bg-white/10 transition-colors">
              Solicitar cotización
            </a>
          </div>
        </div>
        <div class="flex-1 flex justify-center mt-8 lg:mt-0">
          <div class="relative">
            <div class="w-64 h-64 sm:w-72 sm:h-72 lg:w-80 lg:h-80 bg-white/10 rounded-full flex items-center justify-center">
              <div class="w-48 h-48 sm:w-56 sm:h-56 lg:w-64 lg:h-64 bg-white/5 rounded-full flex items-center justify-center">
                <div class="text-center">
                  <div class="text-3xl sm:text-4xl lg:text-5xl font-bold">25+</div>
                  <div class="text-sm sm:text-base text-gray-300">Años de experiencia</div>
                </div>
              </div>
            </div>
            <div class="absolute -top-2 -right-2 sm:-top-3 sm:-right-3 lg:-top-4 lg:-right-4 bg-secondary rounded-full p-2 sm:p-3 lg:p-4">
              <TrendingUp class="w-5 h-5 sm:w-6 sm:h-6 lg:w-8 lg:h-8 text-white" />
            </div>
            <div class="absolute -bottom-2 -left-2 sm:-bottom-3 sm:-left-3 lg:-bottom-4 lg:-left-4 bg-success rounded-full p-2 sm:p-3 lg:p-4">
              <Award class="w-5 h-5 sm:w-6 sm:h-6 lg:w-8 lg:h-8 text-white" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold mb-4">¿Por qué elegir FableTech?</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">Confianza de empresas de todo el mundo por productos de calidad y servicio excepcional</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="bg-white p-6 rounded-xl shadow-sm hover:shadow-md transition-shadow">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
            <Shield class="w-6 h-6 text-primary" />
          </div>
          <h3 class="text-lg font-semibold mb-2">Garantía de calidad</h3>
          <p class="text-gray-600">Procesos de fabricación certificados ISO 9001</p>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-sm hover:shadow-md transition-shadow">
          <div class="w-12 h-12 bg-success/10 rounded-lg flex items-center justify-center mb-4">
            <Globe class="w-6 h-6 text-success" />
          </div>
          <h3 class="text-lg font-semibold mb-2">Alcance global</h3>
          <p class="text-gray-600">Exportación a más de 50 países</p>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-sm hover:shadow-md transition-shadow">
          <div class="w-12 h-12 bg-secondary/10 rounded-lg flex items-center justify-center mb-4">
            <Zap class="w-6 h-6 text-secondary" />
          </div>
          <h3 class="text-lg font-semibold mb-2">Entrega rápida</h3>
          <p class="text-gray-600">Tiempo de entrega promedio menos de 15 días</p>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-sm hover:shadow-md transition-shadow">
          <div class="w-12 h-12 bg-accent/10 rounded-lg flex items-center justify-center mb-4">
            <Award class="w-6 h-6 text-accent" />
          </div>
          <h3 class="text-lg font-semibold mb-2">Equipo experto</h3>
          <p class="text-gray-600">200+ profesionales cualificados</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold mb-4">Productos destacados</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">Descubre nuestros productos metálicos industriales de primera calidad</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {localizedProducts.map((product) => (
          <div key={product.id} class="bg-white rounded-xl shadow-sm overflow-hidden hover:shadow-lg transition-shadow group">
            <div class="aspect-square bg-gray-100 relative overflow-hidden">
              <img 
                src={product.images[0]} 
                alt={product.name[locale]}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform"
              />
              <div class="absolute top-3 right-3 bg-secondary text-white px-3 py-1 text-sm font-medium rounded-full">
                ${product.price}
              </div>
            </div>
            <div class="p-4">
              <h3 class="font-semibold mb-2 truncate">{product.name[locale]}</h3>
              <p class="text-sm text-gray-500 mb-3 line-clamp-2">{product.description[locale]}</p>
              <a href={`/products/${product.id}`} class="inline-flex items-center text-primary hover:text-primary-dark font-medium text-sm">
                Ver detalles
                <ArrowRight class="ml-1 h-4 w-4" />
              </a>
            </div>
          </div>
        ))}
      </div>
      <div class="text-center mt-8">
        <a href="/products" class="inline-flex items-center px-6 py-3 bg-primary hover:bg-primary-dark text-white font-semibold rounded-lg transition-colors">
          Ver todos los productos
          <ArrowRight class="ml-2 h-5 w-5" />
        </a>
      </div>
    </div>
  </section>

  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold mb-4">Noticias recientes</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">Manténgase actualizado con las últimas noticias de la industria y la empresa</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {localizedNews.map((item) => (
          <article key={item.slug} class="bg-white rounded-xl shadow-sm overflow-hidden hover:shadow-lg transition-shadow group">
            <div class="aspect-video bg-gray-100 relative overflow-hidden">
              <img 
                src={item.image} 
                alt={item.title[locale]}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform"
              />
              <div class="absolute top-3 left-3 bg-primary/90 text-white px-3 py-1 text-xs font-medium rounded">
                {item.category}
              </div>
            </div>
            <div class="p-5">
              <time class="text-sm text-gray-500 mb-2 block">{item.publishedTime?.split('T')[0]}</time>
              <h3 class="font-semibold mb-2 group-hover:text-primary transition-colors">{item.title[locale]}</h3>
              <p class="text-sm text-gray-600 line-clamp-2">{item.excerpt}</p>
              <a href={`/news/${item.slug}`} class="inline-flex items-center text-primary hover:text-primary-dark font-medium text-sm mt-3">
                Leer más
                <ArrowRight class="ml-1 h-4 w-4" />
              </a>
            </div>
          </article>
        ))}
      </div>
      <div class="text-center mt-8">
        <a href="/news" class="inline-flex items-center px-6 py-3 border-2 border-primary text-primary hover:bg-primary hover:text-white font-semibold rounded-lg transition-colors">
          Ver todas las noticias
          <ArrowRight class="ml-2 h-5 w-5" />
        </a>
      </div>
    </div>
  </section>

  <section class="py-16 bg-primary">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-white">
      <h2 class="text-3xl font-bold mb-4">¿Listo para empezar?</h2>
      <p class="text-lg text-gray-200 mb-8">Contáctenos hoy para una cotización personalizada o para obtener más información sobre nuestros productos y servicios.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" class="inline-flex items-center justify-center px-8 py-4 bg-secondary hover:bg-secondary/90 text-white font-semibold rounded-lg transition-colors">
          Contáctenos
          <ArrowRight class="ml-2 h-5 w-5" />
        </a>
        <a href="/products" class="inline-flex items-center justify-center px-8 py-4 border-2 border-white text-white font-semibold rounded-lg hover:bg-white/10 transition-colors">
          Navegar productos
        </a>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-gradient-to-r from-primary/5 to-secondary/5 rounded-2xl p-8">
        <h2 class="text-2xl font-bold mb-6 text-center">Solicitar cotización</h2>
        <InquiryForm locale={locale} />
      </div>
    </div>
  </section>
</MainLayout>
