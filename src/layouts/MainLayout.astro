---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AIChat from '../components/AIChat.astro';
import TawkChat from '../components/TawkChat.astro';
import BackToTop from '../components/BackToTop.astro';
import CookieBanner from '../components/CookieBanner.astro';
import ContactButtons from '../components/ContactButtons.astro';
import SEO from '../components/SEO.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import GoogleTagManager from '../components/GoogleTagManager.astro';
import ErrorTracker from '../components/ErrorTracker.astro';
import '../style.css';

interface MainLayoutProps {
  title: string;
  description?: string;
  locale?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  author?: string;
}

const { 
  title, 
  description, 
  locale = 'en',
  image = '/og-image.jpg',
  type = 'website',
  publishedTime,
  author
} = Astro.props;

const defaultDescription = 'FableTech Group - Professional B2B industrial solutions provider with global reach. Quality manufacturing, competitive pricing, and reliable supply chain solutions.';
const gaId = import.meta.env.PUBLIC_GA_ID;
const gtmId = import.meta.env.PUBLIC_GTM_ID;
const pathname = Astro.url.pathname;

function getHreflangUrl(lang: string) {
  const baseUrl = 'https://www.fabletech.cc.cd';
  if (lang === 'en') {
    return baseUrl + pathname;
  }
  return baseUrl + `/${lang}${pathname}`;
}
---

<!DOCTYPE html>
<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description || defaultDescription} />
    
    <SEO 
      title={title}
      description={description || defaultDescription}
      image={image}
      type={type}
      publishedTime={publishedTime}
      author={author}
      locale={locale}
    />
    
    <SchemaOrg />
    <GoogleAnalytics measurementId={gaId} />
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght400;500;600;700&display=swap" rel="stylesheet" />
    
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
  </head>
  <body class={locale === 'ar' ? 'rtl' : ''}>
    <GoogleTagManager gtmId={gtmId} />
    <Header locale={locale} />
    <main><slot /></main>
    <Footer locale={locale} />
    <AIChat />
    <TawkChat />
    <BackToTop />
    <CookieBanner locale={locale} />
    <ContactButtons />
    <ErrorTracker />
  </body>
</html>
