---
import MainLayout from '../../layouts/MainLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import InquiryForm from '../../components/InquiryForm.astro';
import ProductSchema from '../../components/ProductSchema.astro';
import { ArrowLeft, Package, FileText, Download, CheckCircle } from '@lucide/astro';
import { products, getProductCategories } from '../../data/products';
import { supabase, getCurrentUser } from '../../lib/supabase';

export async function getStaticPaths() {
  const languages = ['en', 'de', 'fr', 'es', 'ar'];
  const paths = [];
  for (const lang of languages) {
    for (const product of products) {
      paths.push({
        params: { id: product.id },
        props: { product, locale: lang },
      });
    }
  }
  return paths;
}

const { product, locale } = Astro.props;
const user = supabase ? await getCurrentUser() : null;
const isAuthenticated = !!user;

const categories = getProductCategories();
const categoryProducts = products.filter(p => p.category === product.category && p.id !== product.id).slice(0, 4);

const breadcrumbItems = [
  { name: 'Products', href: '/products' },
  { name: product.name[locale], href: `/products/${product.id}` }
];
---

<MainLayout 
  title={product.name[locale]} 
  description={product.description[locale]}
  locale={locale}
>
  <Breadcrumbs items={breadcrumbItems} locale={locale} />
  
  <section class="py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row gap-8">
        <div class="flex-1">
          <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
            <div class="sm:col-span-3 aspect-square bg-gray-100 rounded-xl overflow-hidden">
              <img src={product.images[0]} alt={product.name[locale]} class="w-full h-full object-cover" />
            </div>
            <div class="sm:col-span-1 flex flex-col gap-4">
              {product.images.slice(1, 5).map((image, idx) => (
                <div key={idx} class="aspect-square bg-gray-100 rounded-lg overflow-hidden cursor-pointer hover:ring-2 hover:ring-primary">
                  <img src={image} alt={`${product.name[locale]} view ${idx + 2}`} class="w-full h-full object-cover" />
                </div>
              ))}
            </div>
          </div>
        </div>
        
        <div class="flex-1">
          <div class="flex items-center gap-2 mb-4">
            <span class="px-3 py-1 bg-primary/10 text-primary text-sm font-medium rounded-full">
              {product.category}
            </span>
          </div>
          
          <h1 class="text-3xl font-bold mb-4">{product.name[locale]}</h1>
          
          <p class="text-gray-600 mb-6">{product.description[locale]}</p>
          
          <div class="flex items-baseline gap-2 mb-6">
            <span class="text-4xl font-bold text-primary">${product.price}</span>
            <span class="text-gray-500">/ piece</span>
          </div>
          
          <div class="space-y-4 mb-8">
            <div class="flex items-center gap-3">
              <Package class="w-5 h-5 text-primary" />
              <span>Available</span>
            </div>
            <div class="flex items-center gap-3">
              <FileText class="w-5 h-5 text-primary" />
              <span>{product.specs?.material || 'Steel'}</span>
            </div>
            <div class="flex items-center gap-3">
              <CheckCircle class="w-5 h-5 text-success" />
              <span>{product.specs?.certification || 'ISO Certified'}</span>
            </div>
          </div>
          
          <div class="bg-gray-50 rounded-xl p-6 mb-8">
            <h3 class="font-semibold mb-3">{locale === 'en' ? 'Specifications' : locale === 'de' ? 'Spezifikationen' : locale === 'fr' ? 'Spécifications' : locale === 'es' ? 'Especificaciones' : 'المواصفات'}</h3>
            <ul class="space-y-2">
              {product.specs && Object.entries(product.specs).map(([key, value], idx) => (
                <li key={idx} class="flex justify-between py-2 border-b border-gray-200 last:border-0">
                  <span class="text-gray-600 capitalize">{key}</span>
                  <span class="font-medium">{value}</span>
                </li>
              ))}
            </ul>
          </div>
          
          <InquiryForm locale={locale} productId={product.id} productName={product.name[locale]} />
        </div>
      </div>
    </div>
  </section>

  <section class="py-12 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold mb-8">{locale === 'en' ? 'Related Products' : locale === 'de' ? 'Verwandte Produkte' : locale === 'fr' ? 'Produits similaires' : locale === 'es' ? 'Productos relacionados' : 'منتجات ذات صلة'}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {categoryProducts.map((item) => (
          <div key={item.id} class="bg-white rounded-xl shadow-sm overflow-hidden hover:shadow-lg transition-shadow">
            <div class="aspect-square bg-gray-100 overflow-hidden">
              <img src={item.images[0]} alt={item.name[locale]} class="w-full h-full object-cover hover:scale-105 transition-transform" />
            </div>
            <div class="p-4">
              <h3 class="font-semibold mb-2 truncate">{item.name[locale]}</h3>
              <p class="text-sm text-gray-500 mb-2">${item.price} / piece</p>
              <a href={`/products/${item.id}`} class="text-primary hover:text-primary-dark font-medium text-sm">
                {locale === 'en' ? 'View Details' : locale === 'de' ? 'Details anzeigen' : locale === 'fr' ? 'Voir les détails' : locale === 'es' ? 'Ver detalles' : 'عرض التفاصيل'}
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <ProductSchema 
    name={product.name[locale]}
    description={product.description[locale]}
    image={product.images[0]}
    price={product.price}
    category={product.category}
  />
</MainLayout>
