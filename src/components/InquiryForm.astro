    company: 'Nombre de la empresa',
    phone: 'Número de teléfono',
    product: 'Producto de interés',
    selectProduct: 'Seleccionar un producto',
    message: 'Su mensaje',
    messagePlaceholder: 'Por favor, describa sus requisitos, cantidades necesarias, ubicación de entrega, etc.',
    submit: 'Enviar consulta',
    successTitle: '¡Consulta enviada con éxito!',
    successMessage: 'Gracias por su mensaje. Nuestro equipo le responderá dentro de las 24 horas.',
    errorTitle: '¡Algo salió mal!',
