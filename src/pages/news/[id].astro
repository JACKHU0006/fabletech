---
import MainLayout from '../../layouts/MainLayout.astro';
import { ArrowLeft, Calendar, Tag } from '@lucide/astro';
import { news, getNewsBySlug } from '../../data/news';

export async function getStaticPaths() {
  const languages = ['en', 'de', 'fr', 'es', 'ar'];
  const paths = [];
  for (const lang of languages) {
    for (const article of news) {
      paths.push({
        params: { id: article.slug },
        props: { article, locale: lang },
      });
    }
  }
  return paths;
}

const { article, locale } = Astro.props;
---

{article && (
  <MainLayout 
    title={`${article.title[locale]} - FableTech Group`} 
    description={article.summary[locale]}
    locale={locale}
  >
    <section class="py-12">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center mb-8">
          <a href="/news" class="inline-flex items-center text-gray-600 hover:text-primary transition-colors">
            <ArrowLeft class="h-5 w-5 mr-2" />
            {locale === 'en' ? 'Back to News' : locale === 'de' ? 'Zurück zu den Nachrichten' : locale === 'fr' ? 'Retour aux nouvelles' : locale === 'es' ? 'Volver a las noticias' : 'العودة إلى الأخبار'}
          </a>
        </div>

        <article class="bg-white rounded-xl shadow-lg overflow-hidden">
          <div class="h-80 bg-gray-200 flex items-center justify-center">
            <img src={article.image} alt={`${article.title[locale]} - FableTech Group ${article.category}`} class="w-full h-full object-cover" />
          </div>

          <div class="p-8">
            <div class="flex items-center justify-between mb-6">
              <span class="flex items-center text-gray-500">
                <Calendar class="h-4 w-4 mr-2" />
                {new Date(article.date).toLocaleDateString(locale, { year: 'numeric', month: 'long', day: 'numeric' })}
              </span>
              <span class="flex items-center bg-primary/10 text-primary px-3 py-1 rounded-full text-sm">
                <Tag class="h-4 w-4 mr-1" />
                {article.category}
              </span>
            </div>

            <h1 class="text-3xl font-bold mb-6">{article.title[locale]}</h1>

            <div class="prose prose-lg max-w-none">
              <p class="text-gray-600 leading-relaxed">{article.content[locale]}</p>
            </div>
          </div>
        </article>
      </div>
    </section>
  </MainLayout>
)}
