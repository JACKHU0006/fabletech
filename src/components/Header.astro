---
import { Menu, X, Globe, User, Search, FileText, Package, Newspaper } from '@lucide/astro';
import { searchData, search, type SearchResult } from '../data/search';

interface HeaderProps {
  locale: string;
}

const { locale } = Astro.props;

const navItems = {
  en: [
    { href: '/', label: 'Home' },
    { href: '/about', label: 'About' },
    { href: '/products', label: 'Products' },
    { href: '/news', label: 'News' },
    { href: '/factory', label: 'Factory' },
    { href: '/service', label: 'Service' },
    { href: '/faq', label: 'FAQ' },
    { href: '/contact', label: 'Contact' },
  ],
  de: [
    { href: '/', label: 'Startseite' },
    { href: '/about', label: 'Über uns' },
    { href: '/products', label: 'Produkte' },
    { href: '/news', label: 'Nachrichten' },
    { href: '/factory', label: 'Fabrik' },
    { href: '/service', label: 'Dienstleistung' },
    { href: '/faq', label: 'FAQ' },
    { href: '/contact', label: 'Kontakt' },
  ],
  fr: [
    { href: '/', label: 'Accueil' },
    { href: '/about', label: 'À propos' },
    { href: '/products', label: 'Produits' },
    { href: '/news', label: 'Nouvelles' },
    { href: '/factory', label: 'Usine' },
    { href: '/service', label: 'Service' },
    { href: '/faq', label: 'FAQ' },
    { href: '/contact', label: 'Contact' },
  ],
  es: [
    { href: '/', label: 'Inicio' },
    { href: '/about', label: 'Sobre nosotros' },
    { href: '/products', label: 'Productos' },
    { href: '/news', label: 'Noticias' },
    { href: '/factory', label: 'Fábrica' },
    { href: '/service', label: 'Servicio' },
    { href: '/faq', label: 'FAQ' },
    { href: '/contact', label: 'Contacto' },
  ],
  ar: [
    { href: '/', label: 'الرئيسية' },
    { href: '/about', label: 'عن الشركة' },
    { href: '/products', label: 'المنتجات' },
    { href: '/news', label: 'الأخبار' },
    { href: '/factory', label: 'المصنع' },
    { href: '/service', label: 'الخدمات' },
    { href: '/faq', label: 'أسئلة شائعة' },
    { href: '/contact', label: 'اتصل بنا' },
  ],
};

const taglines = {
  en: 'Industrial Excellence Worldwide',
  de: 'Industrie-Exzellenz weltweit',
  fr: 'Excellence industrielle mondiale',
  es: 'Excelencia industrial mundial',
  ar: 'التميز الصناعي في جميع أنحاء العالم',
};

const locales = [
  { code: 'en', label: 'English', flag: '🇬🇧' },
  { code: 'de', label: 'Deutsch', flag: '🇩🇪' },
  { code: 'fr', label: 'Français', flag: '🇫🇷' },
  { code: 'es', label: 'Español', flag: '🇪🇸' },
  { code: 'ar', label: 'العربية', flag: '🇸🇦' },
];
---

<header class="bg-white/95 backdrop-blur-sm shadow-sm sticky top-0 z-50 border-b border-gray-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <a href="/" class="flex items-center gap-3 group">
        <div class="flex items-center gap-2">
          <svg viewBox="0 0 120 32" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-auto h-8">
            <defs>
              <linearGradient id="logoGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" style="stop-color:#1e40af"/>
                <stop offset="50%" style="stop-color:#059669"/>
                <stop offset="100%" style="stop-color:#1e40af"/>
              </linearGradient>
            </defs>
            <text x="0" y="24" font-family="Inter, Arial, sans-serif" font-size="22" font-weight="700" fill="url(#logoGrad)">FableTech</text>
          </svg>
        </div>
        <div class="hidden sm:block h-8 flex items-center whitespace-nowrap">
          <span class="text-xs font-medium text-gray-500 tracking-wider uppercase transition-colors group-hover:text-primary">
            {taglines[locale as keyof typeof taglines]}
          </span>
        </div>
      </a>

      <nav class="hidden md:flex items-center space-x-1">
        {navItems[locale as keyof typeof navItems].map((item) => (
          <a
            key={item.href}
            href={item.href}
            class="px-4 py-2 text-sm font-medium text-gray-600 hover:text-primary hover:bg-primary/5 rounded-lg transition-all duration-200 relative group"
          >
            {item.label}
            <span class="absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-0.5 bg-primary rounded-full transition-all duration-200 group-hover:w-3/4" />
          </a>
        ))}
      </nav>

      <div class="flex items-center space-x-2">
        <div class="relative">
          <button
            id="locale-button"
            class="flex items-center space-x-1.5 px-3 py-2 rounded-lg text-gray-600 hover:text-primary hover:bg-gray-50 transition-all duration-200"
          >
            <Globe class="h-4 w-4" />
            <span class="text-sm font-medium">
              {locales.find(l => l.code === locale)?.flag} {locales.find(l => l.code === locale)?.label.split('').slice(0, 2).join('')}
            </span>
          </button>
          <div id="locale-dropdown" class="absolute right-0 mt-2 w-48 bg-white rounded-xl shadow-lg border border-gray-100 py-1 z-50 hidden opacity-0 transform translate-y-2 transition-all duration-200">
            {locales.map((loc) => (
              <button
                key={loc.code}
                onclick={`switchLanguage('${loc.code}')`}
                class={`w-full flex items-center space-x-2 px-4 py-2.5 text-sm transition-all duration-150 ${locale === loc.code ? 'bg-primary/5 text-primary font-medium' : 'text-gray-600 hover:bg-gray-50'}`}
              >
                <span class="text-lg">{loc.flag}</span>
                <span>{loc.label}</span>
                {locale === loc.code && (
                  <svg class="w-4 h-4 ml-auto text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                )}
              </button>
            ))}
          </div>
        </div>

        <button id="search-button" class="p-2.5 text-gray-600 hover:text-primary hover:bg-gray-50 rounded-lg transition-all duration-200">
          <Search class="h-5 w-5" />
        </button>

        <a href="/auth/login" class="p-2.5 text-gray-600 hover:text-primary hover:bg-gray-50 rounded-lg transition-all duration-200">
          <User class="h-5 w-5" />
        </a>

        <button
          id="mobile-menu-button"
          class="md:hidden p-2.5 text-gray-600 hover:text-primary hover:bg-gray-50 rounded-lg transition-all duration-200"
        >
          <Menu class="h-6 w-6" />
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-menu" class="md:hidden bg-white border-t border-gray-100 hidden">
    <div class="px-4 py-4 space-y-1">
      {navItems[locale as keyof typeof navItems].map((item) => (
        <a
          key={item.href}
          href={item.href}
          class="block px-4 py-3 text-base font-medium text-gray-600 hover:text-primary hover:bg-primary/5 rounded-lg transition-all"
        >
          {item.label}
        </a>
      ))}
    </div>
  </div>
</header>

<script id="search-data" type="application/json" data-locale={locale} set:html={JSON.stringify(searchData)} />

<div id="search-modal" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 hidden flex items-start justify-center pt-20">
  <div class="bg-white rounded-2xl shadow-2xl w-full max-w-2xl mx-4 overflow-hidden">
    <div class="p-4 border-b border-gray-100">
      <div class="flex items-center space-x-4">
        <div class="p-2 bg-primary/10 rounded-lg">
          <Search class="h-5 w-5 text-primary" />
        </div>
        <input 
          type="text" 
          id="search-input"
          placeholder="Search products, news, pages..."
          class="flex-1 text-lg outline-none text-gray-800 placeholder-gray-400"
        />
        <button id="close-search" class="p-2 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-lg transition-all">
          <X class="h-5 w-5" />
        </button>
      </div>
    </div>
    <div id="search-results" class="max-h-96 overflow-y-auto">
      <div class="p-6 text-gray-500 text-center" id="search-placeholder">
        <div class="mb-2">Type to search...</div>
        <div class="text-sm text-gray-400">Try: products, news, factory, service</div>
      </div>
    </div>
  </div>
</div>

<script>
  const searchData = JSON.parse(document.getElementById('search-data').textContent);
  const currentLocale = document.getElementById('search-data').dataset.locale;

  function getIcon(type) {
    switch (type) {
      case 'page':
        return '<svg class="h-5 w-5 text-blue-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>';
      case 'product':
        return '<svg class="h-5 w-5 text-green-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>';
      case 'news':
        return '<svg class="h-5 w-5 text-amber-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 22h14a2 2 0 0 0 2-2V7.5L14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="14" x2="7" y2="14"></line><line x1="16" y1="18" x2="7" y2="18"></line><polyline points="10 10 9 10 8 10"></polyline></svg>';
      default:
        return '';
    }
  }

  function performSearch(query) {
    const searchQuery = query.toLowerCase().trim();
    const resultsContainer = document.getElementById('search-results');
    
    if (!searchQuery) {
      resultsContainer.innerHTML = '<div class="p-6 text-gray-500 text-center" id="search-placeholder"><div class="mb-2">Type to search...</div><div class="text-sm text-gray-400">Try: products, news, factory, service</div></div>';
      return;
    }

    const results = searchData.filter(function(item) {
      const title = item.title[currentLocale] || item.title['en'] || '';
      const description = item.description[currentLocale] || item.description['en'] || '';
      const category = item.category || '';
      
      return (
        title.toLowerCase().includes(searchQuery) ||
        description.toLowerCase().includes(searchQuery) ||
        category.toLowerCase().includes(searchQuery)
      );
    }).slice(0, 10);

    if (results.length === 0) {
      resultsContainer.innerHTML = '<div class="p-6 text-gray-500 text-center">No results found...</div>';
      return;
    }

    resultsContainer.innerHTML = results.map(function(item) {
      const title = item.title[currentLocale] || item.title['en'] || '';
      const description = item.description[currentLocale] || item.description['en'] || '';
      
      return '<a href="' + item.url + '" class="flex items-start space-x-3 p-4 hover:bg-gray-50 transition-colors border-b border-gray-50 last:border-b-0">' +
        '<div class="flex-shrink-0 mt-0.5">' + getIcon(item.type) + '</div>' +
        '<div class="flex-1 min-w-0">' +
          '<div class="flex items-center space-x-2">' +
            '<span class="font-medium text-gray-900">' + title + '</span>' +
            (item.category ? '<span class="text-xs bg-gray-100 text-gray-600 px-2 py-0.5 rounded-full">' + item.category + '</span>' : '') +
          '</div>' +
          '<p class="text-sm text-gray-500 mt-1 line-clamp-2">' + description + '</p>' +
        '</div>' +
      '</a>';
    }).join('');
  }

  function switchLanguage(lang) {
    const currentPath = window.location.pathname;
    const pathParts = currentPath.split('/').filter(p => p);
    
    if (pathParts.length > 0 && ['en', 'de', 'fr', 'es', 'ar'].includes(pathParts[0])) {
      pathParts[0] = lang;
    } else {
      pathParts.unshift(lang);
    }
    
    const newPath = '/' + pathParts.join('/');
    window.location.href = newPath || '/';
  }

  document.addEventListener('DOMContentLoaded', function() {
    const localeButton = document.getElementById('locale-button');
    const localeDropdown = document.getElementById('locale-dropdown');
    
    if (localeButton && localeDropdown) {
      localeButton.addEventListener('click', function(e) {
        e.stopPropagation();
        localeDropdown.classList.toggle('hidden');
        setTimeout(() => {
          localeDropdown.classList.toggle('opacity-0');
          localeDropdown.classList.toggle('translate-y-2');
        }, 10);
      });
    }

    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    
    if (mobileMenuButton && mobileMenu) {
      mobileMenuButton.addEventListener('click', function() {
        mobileMenu.classList.toggle('hidden');
        const icon = mobileMenuButton.querySelector('svg');
        if (icon) {
          icon.classList.toggle('rotate-90');
        }
      });
    }

    document.addEventListener('click', function(e) {
      if (localeButton && localeDropdown && !localeButton.contains(e.target)) {
        localeDropdown.classList.add('opacity-0', 'translate-y-2');
        setTimeout(() => {
          localeDropdown.classList.add('hidden');
        }, 200);
      }
    });

    const searchButton = document.getElementById('search-button');
    const searchModal = document.getElementById('search-modal');
    const searchInput = document.getElementById('search-input');
    const closeSearch = document.getElementById('close-search');

    if (searchButton && searchModal) {
      searchButton.addEventListener('click', function() {
        searchModal.classList.remove('hidden');
        setTimeout(() => {
          searchModal.classList.add('opacity-100');
        }, 10);
        if (searchInput) searchInput.focus();
      });
    }

    if (closeSearch && searchModal) {
      closeSearch.addEventListener('click', function() {
        searchModal.classList.remove('opacity-100');
        setTimeout(() => {
          searchModal.classList.add('hidden');
        }, 200);
      });
    }

    if (searchModal) {
      searchModal.addEventListener('click', function(e) {
        if (e.target === searchModal) {
          searchModal.classList.remove('opacity-100');
          setTimeout(() => {
            searchModal.classList.add('hidden');
          }, 200);
        }
      });
    }

    if (searchInput) {
      searchInput.addEventListener('input', function(e) {
        performSearch(e.target.value);
      });
    }

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && searchModal) {
        searchModal.classList.remove('opacity-100');
        setTimeout(() => {
          searchModal.classList.add('hidden');
        }, 200);
      }
      if (e.key === '/' && e.target.tagName !== 'INPUT') {
        e.preventDefault();
        if (searchModal) searchModal.classList.remove('hidden');
        if (searchInput) searchInput.focus();
      }
    });
  });
</script>
