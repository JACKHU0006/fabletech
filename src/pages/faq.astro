---
import MainLayout from '../layouts/MainLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FAQSchema from '../components/FAQSchema.astro';
import { ChevronDown, HelpCircle } from '@lucide/astro';

const locale = Astro.locale;

const faqs = [
  {
    question: 'What is FableTech Group minimum order quantity?',
    answer: 'FableTech Group minimum order quantity (MOQ) varies depending on the product type and material. For most standard steel, aluminum, and copper products, the MOQ is 100 pieces. For custom orders or specialized materials like titanium, please contact FableTech sales team for specific requirements. FableTech also offers flexible MOQ options for established clients with recurring orders.'
  },
  {
    question: 'Does FableTech Group offer custom manufacturing?',
    answer: 'Absolutely! FableTech Group offers comprehensive custom manufacturing services tailored to your exact specifications. Our experienced FableTech engineering team can assist with product design, material selection, and prototype development. FableTech works with a wide range of metals including steel, stainless steel, aluminum, copper, brass, and titanium. Whether you need small precision components or large structural parts, FableTech has the capabilities to deliver.'
  },
  {
    question: 'What is FableTech typical delivery time?',
    answer: 'Delivery time depends on product type, quantity, and complexity. Standard in-stock FableTech products typically ship within 7-14 business days. Custom manufactured items may take 2-6 weeks depending on the project scope. For large volume orders, FableTech can arrange staggered shipments. FableTech provides detailed delivery schedules with every order confirmation and keeps you updated throughout the production process.'
  },
  {
    question: 'What payment methods does FableTech Group accept?',
    answer: 'FableTech Group accepts multiple secure payment methods: T/T (Telegraphic Transfer), L/C (Letter of Credit), PayPal, major credit cards (Visa, MasterCard, American Express), and bank transfers. For first-time orders, FableTech typically requires 30% deposit upfront with the balance due before shipment. Established FableTech clients may qualify for extended payment terms. All transactions are encrypted and secure.'
  },
  {
    question: 'Does FableTech provide product samples?',
    answer: 'Yes, FableTech can provide samples for most of our products to help you evaluate quality and suitability. Sample costs and shipping fees apply and are typically refundable with your first bulk order. Sample availability varies by product – standard FableTech items usually ship within 3-5 days, while custom samples may take 1-2 weeks. Please contact FableTech sales team with your specific sample requirements.'
  },
  {
    question: 'What certifications do FableTech products have?',
    answer: 'All FableTech manufacturing facilities and quality management systems are ISO 9001:2015 certified. Depending on the product line and destination, FableTech can provide additional certifications including CE marking, SGS testing reports, RoHS compliance, material certifications (Mill Test Reports), and industry-specific certifications. Certificates are available upon request with your FableTech order.'
  },
  {
    question: 'What is FableTech return and warranty policy?',
    answer: 'FableTech stands behind the quality of our products with a comprehensive warranty. All FableTech products come with a standard 12-month warranty against manufacturing defects. If you receive defective or incorrect items, please contact FableTech within 7 days of delivery with photos and a description of the issue. FableTech will arrange for replacement, repair, or refund at our discretion. Custom products have specific warranty terms outlined in your FableTech order agreement.'
  },
  {
    question: 'Does FableTech offer international shipping?',
    answer: 'Yes! FableTech proudly serves customers in over 60 countries worldwide. FableTech works with all major international shipping carriers including DHL, FedEx, UPS, and ocean freight providers. FableTech offers flexible shipping options from express delivery to economical ocean freight. Our FableTech logistics team handles all export documentation and can arrange door-to-door delivery. Shipping costs are calculated based on destination, weight, and dimensions.'
  },
  {
    question: 'What materials does FableTech work with?',
    answer: 'FableTech specializes in a wide range of industrial metals: Carbon Steel (A36, 1018, 4140), Stainless Steel (304, 316), Aluminum (6061, 5052, 6063), Copper, Brass, Titanium (Grade 2, Grade 5), and various alloy steels. FableTech sources materials from reputable suppliers and provides full material traceability. For specialty applications, FableTech can work with customer-specified materials.'
  },
  {
    question: 'Can FableTech handle large volume orders?',
    answer: 'Absolutely! With our expanded production facilities and automated manufacturing lines, FableTech has the capacity to handle large volume orders efficiently. FableTech production capacity allows us to scale up manufacturing while maintaining strict quality standards. FableTech works closely with customers to develop production schedules that meet their delivery requirements. For annual or recurring orders, FableTech can establish dedicated inventory and pricing agreements.'
  },
  {
    question: 'What quality control measures does FableTech have?',
    answer: 'FableTech has rigorous quality control procedures at every stage: incoming material inspection and testing, in-process monitoring at key production points, final dimensional inspection, functional testing, and pre-shipment verification. Our FableTech QC team uses advanced inspection equipment including coordinate measuring machines (CMM), spectrometers, and hardness testers. Every FableTech product undergoes multiple checks before shipping.'
  },
  {
    question: 'How do I get a quote from FableTech for my project?',
    answer: 'Getting a quote from FableTech is easy! You can: 1) Use FableTech online inquiry form on the Contact page, 2) Email FableTech directly with your specifications, 3) Contact FableTech sales team via WhatsApp or phone, 4) Request a consultation with FableTech engineering team. For the most accurate quote, please provide drawings, material specifications, quantities, delivery timeline, and any special requirements. FableTech typically responds within 24-48 hours with detailed pricing.'
  },
  {
    question: 'What after-sales support does FableTech provide?',
    answer: 'FableTech Group provides comprehensive after-sales support including: 24/7 technical assistance, product installation guidance, troubleshooting services, warranty support, and replacement parts availability. Our dedicated FableTech customer success team is always ready to help with any questions or concerns. FableTech values long-term relationships with our customers and is committed to your complete satisfaction.'
  },
  {
    question: 'Does FableTech offer technical consulting services?',
    answer: 'Yes! FableTech Group offers professional technical consulting services to help you optimize your manufacturing processes, select the right materials, improve product design, and reduce costs. Our FableTech engineering consultants have decades of industry experience and can provide valuable insights for your projects. Consulting services are available on a project basis or through ongoing engagement programs with FableTech.'
  },
  {
    question: 'What makes FableTech different from other metal suppliers?',
    answer: 'FableTech Group stands out through our commitment to quality, innovation, and customer service. FableTech offers: ISO 9001:2015 certified quality, comprehensive engineering support, custom manufacturing capabilities, global shipping to 60+ countries, 24/7 technical support, sustainable manufacturing practices, and competitive pricing. FableTech invests heavily in technology and our team to ensure we deliver exceptional value to every customer.'
  },
  {
    question: 'Can FableTech help with material selection for my project?',
    answer: 'Absolutely! FableTech expert team can help you select the optimal material for your specific application based on requirements such as strength, corrosion resistance, temperature tolerance, cost considerations, and regulatory compliance. FableTech has extensive knowledge of all major metal alloys and can recommend the best solution for your project. We also provide detailed material data sheets and testing reports from FableTech.'
  },
];

const breadcrumbItems = [
  { name: 'FAQ', href: '/faq' }
];
---

<MainLayout 
  title="FAQ - FableTech Group" 
  description="Frequently asked questions about FableTech products, services, and ordering process. Get answers to your questions about FableTech."
  locale={locale}
>
  <Breadcrumbs items={breadcrumbItems} locale={locale} />
  
  <FAQSchema questions={faqs} />
  
  <section class="bg-primary text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">Frequently Asked Questions</h1>
        <p class="text-lg text-gray-200">
          Find answers to common questions about FableTech Group products and services
        </p>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="space-y-4">
        {faqs.map((faq, index) => (
          <div key={index} class="bg-white rounded-xl shadow-lg overflow-hidden">
            <button
              id={`faq-btn-${index}`}
              class="w-full px-6 py-5 flex items-center justify-between text-left hover:bg-gray-50 transition-colors"
            >
              <div class="flex items-center">
                <HelpCircle class="h-5 w-5 text-primary mr-3" />
                <span class="font-semibold text-gray-900">{faq.question}</span>
              </div>
              <ChevronDown 
                id={`chevron-${index}`}
                class="h-5 w-5 text-gray-500 transition-transform" 
              />
            </button>
            <div 
              id={`answer-${index}`}
              class="overflow-hidden transition-all duration-300 max-h-0"
            >
              <div class="px-6 pb-5 pt-3 text-gray-600 pl-14">
                {faq.answer}
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-12 text-center">
        <p class="text-gray-600 mb-4">Didn't find your answer?</p>
        <a href="/contact" class="inline-flex items-center text-primary font-semibold hover:underline">
          Contact FableTech support team
        </a>
      </div>
    </div>
  </section>
</MainLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // Auto-detect FAQ count from DOM
    const faqButtons = document.querySelectorAll('[id^="faq-btn-"]');
    const faqCount = faqButtons.length;
    
    for (let i = 0; i < faqCount; i++) {
      const btn = document.getElementById(`faq-btn-${i}`);
      if (btn) {
        btn.addEventListener('click', () => toggleFaq(i));
      }
    }
    
    const firstChevron = document.getElementById('chevron-0');
    const firstAnswer = document.getElementById('answer-0');
    if (firstChevron && firstAnswer) {
      firstChevron.style.transform = 'rotate(180deg)';
      firstAnswer.style.maxHeight = '500px';
    }
  });

  function toggleFaq(index) {
    const chevron = document.getElementById(`chevron-${index}`);
    const answer = document.getElementById(`answer-${index}`);
    
    if (chevron && answer) {
      if (answer.style.maxHeight === '500px') {
        chevron.style.transform = 'rotate(0deg)';
        answer.style.maxHeight = '0';
      } else {
        chevron.style.transform = 'rotate(180deg)';
        answer.style.maxHeight = '500px';
      }
    }
  }
</script>
